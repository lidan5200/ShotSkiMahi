<Window x:Class="ShotSkiMahiD.Views.LogViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ShotSkiMahiD.Views"
        xmlns:converters="clr-namespace:ShotSkiMahiD.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="📋 API 日志查看器 - ShotSki Mahi" Height="750" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5">

    <Window.Resources>
        <!-- 成功行样式 -->
        <Style x:Key="SuccessRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="#FFE8F8F0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF27AE60"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD4EDDA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 失败行样式 -->
        <Style x:Key="FailRowStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="#FFFAE8E8"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE74C3C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF5C6CB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 默认行样式 -->
        <Style x:Key="DefaultRowStyle" TargetType="ListViewItem">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFD6EAF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 筛选框样式 -->
        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#FFBDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 按钮样式 -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FF3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF21618C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bool to status text converter -->
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <local:LogItemStyleSelector x:Key="LogStyleSelector"
                                    SuccessStyle="{StaticResource SuccessRowStyle}"
                                    FailStyle="{StaticResource FailRowStyle}"
                                    DefaultStyle="{StaticResource DefaultRowStyle}"/>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题栏 -->
            <RowDefinition Height="Auto"/>   <!-- 工具栏/筛选区 -->
            <RowDefinition Height="Auto"/>   <!-- 统计栏 -->
            <RowDefinition Height="*"/>       <!-- 主内容：列表+详情 -->
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Border Grid.Row="0" Background="#FF2C3E50" CornerRadius="6,6,0,0" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="#FF3498DB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="API 调用日志查看器" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="完整URL / 请求参数 / 响应信息 · 保留7天" FontSize="11" 
                                   Foreground="#FF95A5A6" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Command="{Binding ExportSelectedCommand}" Style="{StaticResource ToolbarButtonStyle}" 
                            Background="#FF27AE60" ToolTip="导出选中日志">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED57;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="导出选中" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButtonStyle}" 
                            Background="#FFF39C12" Margin="8,0,0,0" ToolTip="刷新并重置筛选">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="重置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 筛选工具栏 ===== -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFBDC3C7" 
                BorderThickness="0,1,1,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 搜索关键词 -->
                <TextBlock Grid.Column="0" Text="搜索:" FontSize="12" 
                           Foreground="#FF7F8C8D" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource FilterTextBoxStyle}"/>

                <!-- API 名称筛选 -->
                <TextBlock Grid.Column="3" Text="接口:" FontSize="12" 
                           Foreground="#FF7F8C8D" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="4" ItemsSource="{Binding ApiNameOptions}" 
                          SelectedItem="{Binding ApiNameFilter}" FontSize="12" 
                          Padding="6,4" VerticalContentAlignment="Center"/>

                <!-- 成功/失败筛选 -->
                <TextBlock Grid.Column="6" Text="结果:" FontSize="12" 
                           Foreground="#FF7F8C8D" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="7" ItemsSource="{Binding SuccessFilterOptions}" 
                          SelectedItem="{Binding SelectedSuccessFilter}"
                          DisplayMemberPath="DisplayText"
                          FontSize="12" Padding="6,4" VerticalContentAlignment="Center"/>

                <!-- 开始日期 -->
                <TextBlock Grid.Column="9" Text="从:" FontSize="12" 
                           Foreground="#FF7F8C8D" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="10" SelectedDate="{Binding FilterStartDate}" 
                            FontSize="12" VerticalContentAlignment="Center"/>

                <!-- 结束日期 -->
                <TextBlock Grid.Column="12" Text="到:" FontSize="12" 
                           Foreground="#FF7F8C8D" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="13" SelectedDate="{Binding FilterEndDate}" 
                            FontSize="12" VerticalContentAlignment="Center"/>

                <!-- 搜索按钮 -->
                <Button Grid.Column="15" Command="{Binding SearchCommand}" 
                        Style="{StaticResource ToolbarButtonStyle}" MinWidth="80">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" 
                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="筛选" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== 统计信息栏 ===== -->
        <Border Grid.Row="2" Background="#FFECF0F1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                               Foreground="#FF3498DB" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="共" FontSize="13" Foreground="#FF7F8C8D" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="16" FontWeight="Bold" 
                               Foreground="#FF2C3E50" VerticalAlignment="Center" Margin="3,0"/>
                    <TextBlock Text="条" FontSize="13" Foreground="#FF7F8C8D" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border CornerRadius="3" Padding="6,3" Background="#FFE8F8F0">
                        <TextBlock>
                            <Run Text="✓ 成功: " FontSize="12" Foreground="#FF27AE60"/>
                            <Run Text="{Binding SuccessCount}" FontSize="13" FontWeight="Bold" Foreground="#FF27AE60"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Border CornerRadius="3" Padding="6,3" Background="#FFFAE8E8">
                        <TextBlock>
                            <Run Text="✗ 失败: " FontSize="12" Foreground="#FFE74C3C"/>
                            <Run Text="{Binding FailCount}" FontSize="13" FontWeight="Bold" Foreground="#FFE74C3C"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主内容区：日志列表 + 详情面板 ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="700*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="600*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：日志列表 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#FFBDC3C7" 
                    BorderThickness="1,0,0,0" CornerRadius="0,0,0,6">
                <ListView ItemsSource="{Binding Logs}" 
                          SelectedItem="{Binding SelectedLog}"
                          ItemContainerStyleSelector="{StaticResource LogStyleSelector}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="时间" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" 
                                                   FontFamily="Consolas" FontSize="11"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="接口" Width="145">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ApiName}" FontWeight="SemiBold" FontSize="11"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="状态" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="4,2"
                                                Background="{Binding IsSuccess, Converter={StaticResource BoolToColorConverter}}">
                                            <TextBlock Text="{Binding IsSuccess}" FontSize="10" Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                <Setter Property="Text" Value="✓ OK"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                                <Setter Property="Text" Value="✗ FAIL"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="耗时" Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11">
                                            <Run Text="{Binding ElapsedMs}"/><Run Text="ms" FontSize="9" Foreground="#FF95A5A6"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="完整 URL" Width="350">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FullUrl}" FontSize="10" FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullUrl}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- 分隔条（可拖拽调整大小） -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" 
                          Background="#FFBDC3C7"/>

            <!-- 右侧：详细信息面板 -->
            <Border Grid.Column="2" Background="#FF1E1E1E" CornerRadius="0,0,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto"
                              Padding="12">
                    <TextBlock Text="{Binding DetailText}" 
                               FontFamily="Consolas" FontSize="11.5"
                               Foreground="#FFD4D4D4"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
